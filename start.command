#!/bin/bash
# ポートフォリオ 管理サーバー 起動スクリプト
cd "$(dirname "$0")"

echo "=========================================="
echo "🏀 ポートフォリオ 管理サーバーを起動します"
echo "=========================================="

# ブラウザで管理画面を開く（バックグラウンドで少し遅延させてから起動）
(sleep 1.2 && open "http://localhost:8000/admin.html") &

# Pythonサーバー起動
python3 server.py
